<Window x:Class="LegoBatmanOnline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LEGO Batman Online" Height="680" Width="980" MinHeight="560" MinWidth="820"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontSize="14" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Punkt fuer den Status eines Freundes: gruen online, gelb spielt gerade -->
        <Style x:Key="PresenceDot" TargetType="Ellipse" BasedOn="{StaticResource Dot}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Presence}" Value="on">
                    <Setter Property="Fill" Value="{StaticResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Presence}" Value="busy">
                    <Setter Property="Fill" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfzeile -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Bad}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrokerOnline}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Ok}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding BrokerText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0"/>
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Bad}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GameOk}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Ok}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding GameText}" Foreground="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LEGO Batman Online" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Name, StringFormat='  ·  {0}'}" FontSize="22" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Linke Spalte: Code, Freunde -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="DEIN FREUNDESCODE"/>
                            <DockPanel>
                                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Kopieren" Click="Copy_Click"/>
                                <TextBlock Text="{Binding MyCode}" FontSize="22" FontFamily="Consolas"
                                           FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="Schick diesen Code deinem Freund." Foreground="{StaticResource Muted}"
                                       FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="FREUNDE"/>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Hinzufügen" Margin="8,0,0,0" Click="AddFriend_Click"
                                            Style="{StaticResource Primary}"/>
                                    <TextBox x:Name="FriendCodeBox" FontFamily="Consolas" CharacterCasing="Upper" MaxLength="20"
                                             KeyDown="FriendCodeBox_KeyDown" ToolTip="Code deines Freundes, z. B. ABCD-EFGH-JKLM"/>
                                </DockPanel>
                                <TextBlock x:Name="AddResult" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid>
                                <TextBlock Text="Noch keine Freunde. Gib oben den Code deines Freundes ein."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Friends.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Friends}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource CardHover}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Annehmen" Style="{StaticResource Primary}" Margin="0,0,4,0" Padding="10,5"
                                                                    Click="AcceptFriend_Click"
                                                                    Visibility="{Binding IsIncoming, Converter={StaticResource BoolVis}}"/>
                                                            <Button Content="✕" Style="{StaticResource Quiet}" ToolTip="Entfernen"
                                                                    Click="RemoveFriend_Click"/>
                                                        </StackPanel>
                                                        <Ellipse Style="{StaticResource PresenceDot}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}">
                                                                <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                                                <Run Text="  ·  "/>
                                                                <Run Text="{Binding Code, Mode=OneWay}" FontFamily="Consolas"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0"
                            Visibility="{Binding GameMissing, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="SPIEL NICHT GEFUNDEN"/>
                            <TextBlock Text="LEGO Batman (Steam) wurde nicht gefunden." TextWrapping="Wrap" FontSize="13"/>
                            <Button Content="LEGOBatman.exe auswählen …" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Click="PickGame_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Rechte Spalte: Welten -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="+ Neue Welt" Style="{StaticResource Primary}"
                                    Click="NewWorld_Click" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="GEMEINSAME WELTEN" Margin="0,0,0,2"/>
                                <TextBlock Text="Ein Spielstand, den ihr teilt. Jeder kann alleine weiterspielen – seid ihr beide online, spielt ihr zusammen."
                                           Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0"/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox DockPanel.Dock="Top" IsChecked="{Binding AutoLoad}" Margin="0,10,0,12"
                                  Content="Beim Zusammenspielen den Spielstand automatisch laden"/>
                        <Grid>
                            <TextBlock Text="Noch keine Welt. Füge einen Freund hinzu und erstelle mit „+ Neue Welt“ eure erste."
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Worlds.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Worlds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardHover}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <Button Content="📁" Style="{StaticResource Quiet}" ToolTip="Sicherungen öffnen"
                                                                    Click="OpenBackups_Click"/>
                                                            <Button Content="✕" Style="{StaticResource Quiet}" ToolTip="Welt entfernen"
                                                                    Click="RemoveWorld_Click"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Ellipse DataContext="{Binding Partner}" Style="{StaticResource PresenceDot}"
                                                                 Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                        <TextBlock FontSize="13">
                                                            <Run Text="{Binding PartnerText, Mode=OneWay}"/>
                                                            <Run Text="·" Foreground="{StaticResource Muted}"/>
                                                            <Run Text="{Binding PartnerStatus, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Muted}" FontSize="12"
                                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding SyncText}" Foreground="{StaticResource Muted}" FontSize="11"
                                                               FontStyle="Italic" Margin="0,2,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                        <Button Content="Zusammen spielen" Style="{StaticResource Primary}" Margin="0,0,8,0"
                                                                Click="PlayTogether_Click" IsEnabled="{Binding CanPlayTogether}"/>
                                                        <Button Content="Alleine spielen" Click="PlaySolo_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Fusszeile: Hinweis + Protokoll -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Accent}" FontSize="13" TextWrapping="Wrap"/>
                <Expander Header="Protokoll" Foreground="{StaticResource Muted}" Margin="0,6,0,0">
                    <ListBox ItemsSource="{Binding Log}" Height="110" Background="{StaticResource Card}"
                             BorderThickness="0" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12"/>
                </Expander>
            </StackPanel>
        </Grid>

        <!-- Neue Welt -->
        <Border x:Name="NewWorldOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorder}" Width="480" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Neue Welt" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
                    <TextBlock Style="{StaticResource Heading}" Text="NAME"/>
                    <TextBox x:Name="WorldNameBox" MaxLength="24" Margin="0,0,0,14"/>
                    <TextBlock Style="{StaticResource Heading}" Text="MIT WEM?"/>
                    <ListBox x:Name="PartnerList" Style="{StaticResource CardList}" MaxHeight="130" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource PresenceDot}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Heading}" Text="WOMIT STARTET IHR?" Margin="0,6,0,8"/>
                    <ListBox x:Name="SeedList" Style="{StaticResource CardList}" MaxHeight="170">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Dein eigener Spielstand bleibt unverändert – die Welt bekommt eine Kopie."
                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="NewWorldError" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Abbrechen" Margin="0,0,8,0" Click="CancelNewWorld_Click"/>
                        <Button Content="Welt erstellen" Style="{StaticResource Primary}" Click="CreateWorld_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Einladung erhalten -->
        <Border Background="#CC000000" Visibility="{Binding HasIncoming, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource CardBorder}" Width="420" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="EINLADUNG"/>
                    <TextBlock Text="{Binding Incoming.Text}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Das Spiel startet nach dem Annehmen automatisch. Gespeichert wird beim Einladenden, danach bekommst du den neuen Stand."
                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Ablehnen" Margin="0,0,8,0" Click="Decline_Click"/>
                        <Button Content="Annehmen und spielen" Style="{StaticResource Primary}" Click="AcceptInvite_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Laufende Sitzung -->
        <Border Background="#CC000000" Visibility="{Binding SessionActive, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource CardBorder}" Width="440" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="SPIEL"/>
                    <TextBlock Text="{Binding SessionText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,16" Foreground="{StaticResource Accent}"
                                 Background="{StaticResource Line}" BorderThickness="0"/>
                    <TextBlock Text="Lass dieses Fenster offen, solange du spielst. Nach dem Spiel wird der Stand automatisch abgeglichen."
                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Button Content="Abbrechen" HorizontalAlignment="Right" Click="CancelSession_Click"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Ersteinrichtung: Name -->
        <Border x:Name="SetupOverlay" Background="{StaticResource Bg}" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorder}" Width="440" VerticalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="Willkommen!" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Mit dieser App spielst du LEGO Batman mit einem Freund übers Internet. Wie sollen dich deine Freunde sehen?"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="13"/>
                    <TextBox x:Name="NameBox" MaxLength="24" KeyDown="NameBox_KeyDown"/>
                    <Button Content="Los geht's" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0,16,0,0"
                            Click="SaveName_Click"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
