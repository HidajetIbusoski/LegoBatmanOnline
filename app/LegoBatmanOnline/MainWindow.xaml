<Window x:Class="LegoBatmanOnline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LEGO Online – Multiplayer" Height="820" Width="1400" MinHeight="660" MinWidth="1100"
        Background="#05070B" Foreground="{StaticResource Text}" FontSize="14" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Neon" Color="#36E2FF"/>
        <SolidColorBrush x:Key="NeonDim" Color="#5936E2FF"/>
        <SolidColorBrush x:Key="NeonFaint" Color="#2236E2FF"/>
        <SolidColorBrush x:Key="Glass" Color="#C40A0E16"/>
        <SolidColorBrush x:Key="GlassLight" Color="#33FFFFFF"/>
        <FontFamily x:Key="Display">Bahnschrift</FontFamily>

        <!-- Punkt fuer den Status eines Freundes: gruen online, gelb spielt gerade -->
        <Style x:Key="PresenceDot" TargetType="Ellipse" BasedOn="{StaticResource Dot}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Presence}" Value="on">
                    <Setter Property="Fill" Value="{StaticResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Presence}" Value="busy">
                    <Setter Property="Fill" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Glas-Panel mit Eckwinkeln (Sci-Fi-Rahmen) -->
        <Style x:Key="Panel" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource NeonFaint}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <Path Data="M0,14 L0,0 L14,0" Stroke="{StaticResource Neon}" StrokeThickness="2"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Path Data="M0,0 L14,0 L14,14" Stroke="{StaticResource Neon}" StrokeThickness="2"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Path Data="M0,0 L0,14 L14,14" Stroke="{StaticResource Neon}" StrokeThickness="2"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Path Data="M14,0 L14,14 L0,14" Stroke="{StaticResource Neon}" StrokeThickness="2"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Neon}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Leuchtender Hauptknopf -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Foreground" Value="#04121A"/>
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="34,13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7AF0FF" Offset="0"/>
                                    <GradientStop Color="#1FB8E8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" Color="#36E2FF" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#36E2FF" BlurRadius="34" ShadowDepth="0" Opacity="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="b" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Umriss-Knopf -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#33081018" BorderBrush="{StaticResource NeonDim}" BorderThickness="1"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Neon}"/>
                                <Setter TargetName="b" Property="Background" Value="#3336E2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Runde Icon-Knoepfe der Seitenleiste -->
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="ring" Stroke="{StaticResource NeonDim}" StrokeThickness="1" Fill="#66081018"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Neon}"/>
                                <Setter TargetName="ring" Property="Fill" Value="#4436E2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Spielkachel: quadratisch, ausgewaehlt groesser mit Leuchtrand -->
        <DataTemplate x:Key="TileTemplate">
            <Grid Width="122" Height="122" Margin="0,0,18,0" Cursor="Hand" VerticalAlignment="Center"
                  MouseLeftButtonUp="Tile_Click">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <Border x:Name="frame" CornerRadius="10" BorderThickness="2" BorderBrush="#33FFFFFF">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Tile}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <Border x:Name="dim" CornerRadius="10" Background="#99000000"/>
                <Border x:Name="soon" CornerRadius="0,0,10,10" Background="#CC05070B" VerticalAlignment="Bottom" Padding="0,3"
                        Visibility="Collapsed">
                    <TextBlock Text="BALD" FontFamily="{StaticResource Display}" FontSize="11" Foreground="{StaticResource Neon}"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Available}" Value="False">
                    <Setter TargetName="soon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource Neon}"/>
                    <Setter TargetName="dim" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="frame" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#36E2FF" BlurRadius="28" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.26" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.26" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Hintergrund: Bild des gewaehlten Spiels, Ueberblendung in MainWindow.xaml.cs -->
        <Image x:Name="BgA" Stretch="UniformToFill" VerticalAlignment="Top"/>
        <Image x:Name="BgB" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F205070B" Offset="0"/>
                    <GradientStop Color="#B305070B" Offset="0.38"/>
                    <GradientStop Color="#2205070B" Offset="0.75"/>
                    <GradientStop Color="#6605070B" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#9905070B" Offset="0"/>
                    <GradientStop Color="#0005070B" Offset="0.3"/>
                    <GradientStop Color="#0005070B" Offset="0.5"/>
                    <GradientStop Color="#F805070B" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- feines HUD-Raster -->
        <Rectangle Opacity="0.07" IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,0 L44,0 M0,0 L0,44">
                            <GeometryDrawing.Pen><Pen Brush="#36E2FF" Thickness="0.6"/></GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="0,0,34,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Runde Icon-Leiste links -->
            <StackPanel Margin="0,108,0,0" HorizontalAlignment="Center">
                <Border Width="1" Height="40" Background="{StaticResource NeonDim}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <Button Style="{StaticResource RailButton}" Content="&#xE7FC;" ToolTip="Spiele" Click="RailGames_Click"/>
                <Button Style="{StaticResource RailButton}" Content="&#xE716;" ToolTip="Freund hinzufügen" Click="RailFriends_Click"/>
                <Button Style="{StaticResource RailButton}" Content="&#xE8C8;" ToolTip="Freundescode kopieren" Click="Copy_Click"/>
                <Button Style="{StaticResource RailButton}" Content="&#xE9D9;" ToolTip="Protokoll" Click="RailLog_Click"/>
                <Border Width="1" Height="80" Background="{StaticResource NeonDim}" HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Kopfzeile -->
                <DockPanel VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Bad}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BrokerOnline}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Ok}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding BrokerText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,26,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{StaticResource NeonDim}" BorderThickness="1" Padding="12,6" Margin="0,0,22,0" Background="#66081018"
                                Cursor="Hand" MouseLeftButtonUp="Copy_Click" ToolTip="Freundescode kopieren">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CODE " FontFamily="{StaticResource Display}" FontSize="12" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="CodeText" Text="{Binding MyCode}" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource Neon}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Grid Width="38" Height="38" Margin="0,0,12,0">
                            <Ellipse Stroke="{StaticResource Neon}" StrokeThickness="1.5" Fill="#33081018"/>
                            <TextBlock x:Name="Initial" Text="?" FontFamily="{StaticResource Display}" FontSize="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,26,0">
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="15"/>
                            <TextBlock Text="ONLINE" FontSize="10" Foreground="{StaticResource Ok}"/>
                        </StackPanel>
                        <TextBlock x:Name="Clock" FontFamily="{StaticResource Display}" FontSize="22" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="3" Background="#E3000B" Margin="0,0,12,0">
                            <TextBlock Text="LEGO" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="11" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ONLINE" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  //  MULTIPLAYER" FontFamily="{StaticResource Display}" FontSize="14" Foreground="{StaticResource Neon}"
                                   VerticalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource NeonFaint}"/>
                <Rectangle x:Name="ScanLine" Height="1" Width="220" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0036E2FF" Offset="0"/>
                            <GradientStop Color="#FF36E2FF" Offset="0.5"/>
                            <GradientStop Color="#0036E2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="ScanX"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- Spielkacheln -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource TileTemplate}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel VerticalAlignment="Center" Margin="26,0,0,0">
                        <TextBlock Text="{Binding SelectedGame.Title}" FontFamily="{StaticResource Display}" FontSize="20"/>
                        <TextBlock Text="{Binding SelectedGame.Year}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Inhalt: links Spiel, rechts Freunde/Welten -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="InfoPanel" VerticalAlignment="Bottom" Margin="0,0,40,8" MaxWidth="720" HorizontalAlignment="Left">
                        <Image x:Name="LogoImage" Source="{Binding SelectedGame.Logo}" MaxHeight="150" MaxWidth="500"
                               HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,18">
                            <Image.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.8"/>
                            </Image.Effect>
                        </Image>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Padding="10,4" Margin="0,0,10,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#33E5484D"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Bad}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGame.Available}" Value="True">
                                                <Setter Property="Background" Value="#3336E2FF"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Neon}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SelectedGame.StatusText}" FontFamily="{StaticResource Display}" FontSize="12"/>
                            </Border>
                            <Border Padding="10,4" BorderBrush="#44FFFFFF" BorderThickness="1">
                                <TextBlock Text="2 SPIELER  ·  ONLINE" FontFamily="{StaticResource Display}" FontSize="12"
                                           Foreground="{StaticResource Muted}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedGame.Description}" TextWrapping="Wrap" FontSize="15" LineHeight="23"
                                   Foreground="#D8DEE8" Margin="0,0,0,24"/>

                        <!-- Batman 1: Spiel nicht gefunden -->
                        <ContentControl Style="{StaticResource Panel}" Margin="0,0,0,18" Padding="16"
                                        Visibility="{Binding ShowGameMissing, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="LEGOBatman.exe auswählen …"
                                        Click="PickGame_Click" VerticalAlignment="Center"/>
                                <TextBlock Text="LEGO Batman (Steam) wurde nicht gefunden." VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                        </ContentControl>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PlayButton" Style="{StaticResource NeonButton}" Content="{Binding SelectedGame.PlayText}"
                                    IsEnabled="{Binding SelectedGame.Available}" Click="Play_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="+ Neue Welt" Margin="14,0,0,0" Click="NewWorld_Click"
                                    Visibility="{Binding IsBatman1, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Accent}" FontSize="13" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- Rechte Spalte -->
                    <ContentControl Grid.Column="1" Style="{StaticResource Panel}" Margin="0,10,0,8">
                        <DockPanel>
                            <!-- Welten (nur LEGO Batman 1) -->
                            <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsBatman1, Converter={StaticResource BoolVis}}"
                                        Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Label}" Text="GEMEINSAME WELTEN"/>
                                <CheckBox IsChecked="{Binding AutoLoad}" Margin="0,0,0,10" FontSize="12"
                                          Content="Spielstand beim Zusammenspielen automatisch laden"/>
                                <TextBlock Text="Noch keine Welt. Erstelle mit „+ Neue Welt“ eure erste."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Worlds.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Worlds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#22FFFFFF" BorderBrush="#2236E2FF" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Button Content="📁" Style="{StaticResource Quiet}" ToolTip="Sicherungen öffnen" Click="OpenBackups_Click"/>
                                                                <Button Content="✕" Style="{StaticResource Quiet}" ToolTip="Welt entfernen" Click="RemoveWorld_Click"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="16"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <Ellipse DataContext="{Binding Partner}" Style="{StaticResource PresenceDot}" Margin="0,0,7,0"
                                                                     VerticalAlignment="Center"/>
                                                            <TextBlock FontSize="12">
                                                                <Run Text="{Binding PartnerText, Mode=OneWay}"/>
                                                                <Run Text="·" Foreground="{StaticResource Muted}"/>
                                                                <Run Text="{Binding PartnerStatus, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Muted}" FontSize="11"
                                                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding SyncText}" Foreground="{StaticResource Muted}" FontSize="11"
                                                                   FontStyle="Italic" Margin="0,2,0,0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Button Content="Zusammen spielen" Style="{StaticResource GhostButton}" Padding="12,6" FontSize="13"
                                                                    Margin="0,0,8,0" Click="PlayTogether_Click" IsEnabled="{Binding CanPlayTogether}"/>
                                                            <Button Content="Alleine" Style="{StaticResource GhostButton}" Padding="12,6" FontSize="13"
                                                                    Click="PlaySolo_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- Freunde -->
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="FREUNDE"/>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Hinzufügen" Margin="8,0,0,0" Click="AddFriend_Click"
                                            Style="{StaticResource GhostButton}" Padding="12,6" FontSize="13"/>
                                    <TextBox x:Name="FriendCodeBox" FontFamily="Consolas" CharacterCasing="Upper" MaxLength="20"
                                             KeyDown="FriendCodeBox_KeyDown" ToolTip="Code deines Freundes, z. B. ABCD-EFGH-JKLM"
                                             Background="#66081018"/>
                                </DockPanel>
                                <TextBlock x:Name="AddResult" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid>
                                <TextBlock Text="Noch keine Freunde. Gib oben den Code deines Freundes ein."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Friends.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Friends}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#18FFFFFF" Padding="10,8" Margin="0,0,0,6" BorderBrush="#1436E2FF" BorderThickness="1">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Annehmen" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Padding="10,5" FontSize="12"
                                                                    Click="AcceptFriend_Click"
                                                                    Visibility="{Binding IsIncoming, Converter={StaticResource BoolVis}}"/>
                                                            <Button Content="Einladen" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Padding="10,5" FontSize="12"
                                                                    ToolTip="Zusammen LEGO Batman 2 spielen"
                                                                    Click="PlayBatman2_Click" IsEnabled="{Binding Online}">
                                                                <Button.Visibility>
                                                                    <MultiBinding Converter="{StaticResource AllTrueVis}">
                                                                        <Binding Path="IsFriend"/>
                                                                        <Binding Path="DataContext.IsBatman2" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    </MultiBinding>
                                                                </Button.Visibility>
                                                            </Button>
                                                            <Button Content="✕" Style="{StaticResource Quiet}" ToolTip="Entfernen" Click="RemoveFriend_Click"/>
                                                        </StackPanel>
                                                        <Ellipse Style="{StaticResource PresenceDot}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}">
                                                                <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                                                <Run Text="  ·  "/>
                                                                <Run Text="{Binding Code, Mode=OneWay}" FontFamily="Consolas"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </ContentControl>
                </Grid>

                <!-- Fusszeile: Tasten + Protokoll -->
                <DockPanel Grid.Row="3" Margin="0,4,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="◀ ▶" Foreground="{StaticResource Neon}" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="Spiel wählen" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,18,0"/>
                        <TextBlock Text="ENTER" Foreground="{StaticResource Neon}" FontFamily="{StaticResource Display}" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="Spielen" Foreground="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                    <Expander x:Name="LogExpander" Header="Protokoll" Foreground="{StaticResource Muted}" FontSize="12">
                        <ListBox ItemsSource="{Binding Log}" Height="110" Background="#C40A0E16"
                                 BorderThickness="0" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12"/>
                    </Expander>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Freund fuer LEGO Batman 2 waehlen -->
        <Border x:Name="PickFriendOverlay" Background="#CC000000" Visibility="Collapsed">
            <ContentControl Style="{StaticResource Panel}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="MITSPIELER WÄHLEN"/>
                    <TextBlock Text="Wen möchtest du einladen?" FontFamily="{StaticResource Display}" FontSize="20" Margin="0,0,0,14"/>
                    <ListBox x:Name="PickFriendList" Style="{StaticResource CardList}" MaxHeight="240" MouseDoubleClick="PickFriendOk_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource PresenceDot}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="PickFriendError" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Abbrechen" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="PickFriendCancel_Click"/>
                        <Button Content="Einladen" Style="{StaticResource NeonButton}" Padding="22,9" FontSize="15" Click="PickFriendOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </Border>

        <!-- Neue Welt -->
        <Border x:Name="NewWorldOverlay" Background="#CC000000" Visibility="Collapsed">
            <ContentControl Style="{StaticResource Panel}" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="LEGO BATMAN"/>
                    <TextBlock Text="Neue Welt" FontFamily="{StaticResource Display}" FontSize="22" Margin="0,0,0,14"/>
                    <TextBlock Style="{StaticResource Heading}" Text="NAME"/>
                    <TextBox x:Name="WorldNameBox" MaxLength="24" Margin="0,0,0,14" Background="#66081018"/>
                    <TextBlock Style="{StaticResource Heading}" Text="MIT WEM?"/>
                    <ListBox x:Name="PartnerList" Style="{StaticResource CardList}" MaxHeight="130" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource PresenceDot}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Heading}" Text="WOMIT STARTET IHR?" Margin="0,6,0,8"/>
                    <ListBox x:Name="SeedList" Style="{StaticResource CardList}" MaxHeight="170">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Dein eigener Spielstand bleibt unverändert – die Welt bekommt eine Kopie."
                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="NewWorldError" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Abbrechen" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="CancelNewWorld_Click"/>
                        <Button Content="Welt erstellen" Style="{StaticResource NeonButton}" Padding="22,9" FontSize="15" Click="CreateWorld_Click"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </Border>

        <!-- Einladung erhalten -->
        <Border Background="#CC000000" Visibility="{Binding HasIncoming, Converter={StaticResource BoolVis}}">
            <ContentControl Style="{StaticResource Panel}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="EINLADUNG"/>
                    <TextBlock Text="{Binding Incoming.Text}" FontFamily="{StaticResource Display}" FontSize="20" TextWrapping="Wrap"/>
                    <TextBlock Text="Das Spiel startet nach dem Annehmen automatisch."
                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Ablehnen" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Decline_Click"/>
                        <Button Content="Annehmen und spielen" Style="{StaticResource NeonButton}" Padding="22,9" FontSize="15" Click="AcceptInvite_Click"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </Border>

        <!-- Laufende Sitzung -->
        <Border Background="#CC000000" Visibility="{Binding SessionActive, Converter={StaticResource BoolVis}}">
            <ContentControl Style="{StaticResource Panel}" Width="470" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="SITZUNG"/>
                    <TextBlock Text="{Binding SessionText}" FontFamily="{StaticResource Display}" FontSize="20" TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,18,0,18" Foreground="{StaticResource Neon}"
                                 Background="#22FFFFFF" BorderThickness="0"/>
                    <TextBlock Text="Lass dieses Fenster offen, solange du spielst."
                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Button Content="Abbrechen" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="CancelSession_Click"/>
                </StackPanel>
            </ContentControl>
        </Border>

        <!-- Ersteinrichtung: Name -->
        <Border x:Name="SetupOverlay" Background="#F205070B" Visibility="Collapsed">
            <ContentControl Style="{StaticResource Panel}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="WILLKOMMEN"/>
                    <TextBlock Text="LEGO Online" FontFamily="{StaticResource Display}" FontSize="26"/>
                    <TextBlock Text="Spiele LEGO-Spiele mit einem Freund übers Internet. Wie sollen dich deine Freunde sehen?"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="13"/>
                    <TextBox x:Name="NameBox" MaxLength="24" KeyDown="NameBox_KeyDown" Background="#66081018"/>
                    <Button Content="Los geht's" Style="{StaticResource NeonButton}" Padding="22,9" FontSize="15" HorizontalAlignment="Right"
                            Margin="0,18,0,0" Click="SaveName_Click"/>
                </StackPanel>
            </ContentControl>
        </Border>
    </Grid>
</Window>
