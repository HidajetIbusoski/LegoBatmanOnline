<Window x:Class="LegoBatmanOnline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LEGO Online – Multiplayer" Height="820" Width="1400" MinHeight="660" MinWidth="1100"
        Background="Black" Foreground="White" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" UseLayoutRounding="True"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Startseite im Stil des PS5-Menues: weisse Schrift, weisse Auswahlrahmen, blaue Akzente -->
        <SolidColorBrush x:Key="Soft" Color="#C9CDD4"/>
        <SolidColorBrush x:Key="Dim" Color="#8D939D"/>
        <SolidColorBrush x:Key="Blue" Color="#4DA3FF"/>
        <SolidColorBrush x:Key="Sheet" Color="#F2131519"/>
        <SolidColorBrush x:Key="Row" Color="#14FFFFFF"/>
        <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>

        <!-- Punkt fuer den Status eines Freundes: gruen online, gelb spielt gerade -->
        <Style x:Key="PresenceDot" TargetType="Ellipse" BasedOn="{StaticResource Dot}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Presence}" Value="on">
                    <Setter Property="Fill" Value="{StaticResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Presence}" Value="busy">
                    <Setter Property="Fill" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dunkle Karte fuer Dialoge -->
        <Style x:Key="Panel" TargetType="ContentControl">
            <Setter Property="Padding" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="#F51A1C21" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Weisser Pillenknopf (Hauptaktion) -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#111316"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="30,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#F2F3F5" CornerRadius="24" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="White"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="White" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Durchscheinender Pillenknopf -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#24FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#40FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#B3FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kategorie-Reiter: ausgewaehlt mit blauem Pillenrahmen -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Kategorie"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="16" BorderThickness="2" BorderBrush="Transparent" Background="Transparent"
                                Padding="13,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kleines Tasten-Symbol (Q / E neben den Reitern) -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Tastenhinweis unten rechts: runder Knopf mit Taste (Tag) und Beschriftung -->
        <Style x:Key="HintButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="18,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="17" Padding="5,5,12,5" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="cap" Width="24" Height="24" CornerRadius="12" Background="#2EFFFFFF" Margin="0,0,8,0">
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hauptaktion "Spielen": helle Pille wie auf der Konsole -->
        <Style x:Key="PlayHint" TargetType="Button" BasedOn="{StaticResource HintButton}">
            <Setter Property="Foreground" Value="#1B1D21"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="17" Padding="5,5,16,5" Background="#E6F2F3F5">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#1F000000" Margin="0,0,8,0">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Symbol oben rechts (Glocke, Freunde) mit Zahl -->
        <Style x:Key="TopIcon" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,22,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="6,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Spielkachel: quadratisch; ausgewaehlt groesser mit weissem Rahmen -->
        <DataTemplate x:Key="TileTemplate">
            <Grid Width="188" Height="188" Margin="0,0,14,0" Cursor="Hand" VerticalAlignment="Bottom"
                  MouseLeftButtonUp="Tile_Click">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <Border CornerRadius="5">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Tile}" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.55"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="frame" CornerRadius="6" BorderThickness="3" BorderBrush="Transparent" Margin="-5"/>
                <Border x:Name="soon" CornerRadius="9" Background="#D9101215" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,8,0" Padding="8,2" Visibility="Collapsed">
                    <TextBlock Text="BALD" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Available}" Value="False">
                    <Setter TargetName="soon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="frame" Property="BorderBrush" Value="#F2FFFFFF"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.17" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.17" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Hintergrund: Vollbild des gewaehlten Spiels, Ueberblendung in MainWindow.xaml.cs -->
        <Image x:Name="BgA" Stretch="UniformToFill"/>
        <Image x:Name="BgB" Stretch="UniformToFill" Opacity="0"/>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#A6000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="0.26"/>
                    <GradientStop Color="#00000000" Offset="0.5"/>
                    <GradientStop Color="#99000000" Offset="0.8"/>
                    <GradientStop Color="#D9000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#66000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="0.35"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="Home">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfzeile: links Uhr und Verbindung, rechts Hinweise, Freunde, Profil -->
            <DockPanel Margin="64,26,48,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Clock" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE701;" FontSize="15" Margin="12,1,0,0"
                               VerticalAlignment="Center" ToolTip="{Binding BrokerText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrokerOnline}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopIcon}" Click="OpenFriends_Click" ToolTip="Freundschaftsanfragen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEA8F;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BellCount" Text="0" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopIcon}" Click="OpenFriends_Click" ToolTip="Freunde online">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE716;" FontSize="17" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OnlineCount" Text="0" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Grid Width="40" Height="40" Margin="4,0,12,0">
                        <Ellipse Fill="#3B4250"/>
                        <TextBlock x:Name="Initial" Text="?" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="Black" StrokeThickness="2">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Dim}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BrokerOnline}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Blue}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Copy_Click" ToolTip="Freundescode kopieren">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8C8;" FontSize="10" Foreground="{StaticResource Soft}"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="CodeText" Text="{Binding MyCode}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Soft}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Kategorien -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="64,34,0,0">
                <Border Style="{StaticResource KeyCap}" Margin="0,0,14,0">
                    <TextBlock Text="Q" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Soft}"/>
                </Border>
                <RadioButton x:Name="TabAll" Style="{StaticResource Tab}" Content="ALLE" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabCoop" Style="{StaticResource Tab}" Content="ONLINE-KOOP" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabSoon" Style="{StaticResource Tab}" Content="DEMNÄCHST" Checked="Tab_Checked"/>
                <Border Style="{StaticResource KeyCap}" Margin="4,0,0,0">
                    <TextBlock Text="E" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Soft}"/>
                </Border>
            </StackPanel>

            <!-- Spielkacheln -->
            <ItemsControl x:Name="TileList" Grid.Row="3" ItemTemplate="{StaticResource TileTemplate}" Margin="64,0,0,0"
                          VerticalAlignment="Bottom">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Gewaehltes Spiel -->
            <StackPanel x:Name="TitleBlock" Grid.Row="4" Margin="66,18,0,0">
                <TextBlock Text="{Binding SelectedGame.Title}" FontSize="22" FontWeight="SemiBold">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding SelectedGame.Year}" FontSize="13" Foreground="{StaticResource Soft}"/>
                    <TextBlock Text="  ·  " FontSize="13" Foreground="{StaticResource Dim}"/>
                    <TextBlock Text="{Binding SelectedGame.StatusText}" FontSize="13" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Soft}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedGame.Available}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="  ·  2 SPIELER" FontSize="13" Foreground="{StaticResource Soft}"/>
                </StackPanel>
                <!-- Batman 1: Spiel nicht gefunden -->
                <Border Background="#D91A1C21" CornerRadius="10" Padding="14,8" Margin="0,12,0,0" HorizontalAlignment="Left"
                        Visibility="{Binding ShowGameMissing, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LEGO Batman (Steam) wurde nicht gefunden." VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Style="{StaticResource SoftButton}" Content="LEGOBatman.exe auswählen …" Padding="14,6" FontSize="13"
                                Click="PickGame_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Fusszeile: Protokoll links, Tastenhinweise rechts -->
            <DockPanel Grid.Row="6" Margin="64,0,48,26">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HintButton}" Tag="F" Content="FREUNDE" Click="OpenFriends_Click" ToolTip="Taste F"/>
                    <Button Style="{StaticResource HintButton}" Tag="W" Content="WELTEN" Click="OpenFriends_Click" ToolTip="Taste W"
                            Visibility="{Binding IsBatman1, Converter={StaticResource BoolVis}}"/>
                    <Button Style="{StaticResource HintButton}" Tag="D" Content="DETAILS" Click="Details_Click" ToolTip="Taste D"/>
                    <Button x:Name="PlayButton" Style="{StaticResource PlayHint}" Tag="&#xE751;" Margin="18,0,0,0" Click="Play_Click"
                            IsEnabled="{Binding SelectedGame.Available}" ToolTip="Enter">
                        <TextBlock Text="{Binding SelectedGame.PlayHint}"/>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource HintButton}" Tag="P" Content="PROTOKOLL" Margin="0" HorizontalAlignment="Left"
                        Foreground="{StaticResource Soft}" Click="Log_Click" ToolTip="Taste P"/>
            </DockPanel>
        </Grid>

        <!-- Protokoll -->
        <Border x:Name="LogPanel" Visibility="Collapsed" Background="#F0101215" CornerRadius="10" Width="640" Height="220"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="64,0,0,80" Padding="12">
            <ListBox ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Soft}"
                     FontFamily="Consolas" FontSize="12"/>
        </Border>

        <!-- Benachrichtigung oben in der Mitte -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" MinWidth="380" MaxWidth="600"
                Background="#F0262930" CornerRadius="3" Opacity="0" IsHitTestVisible="False" Cursor="Hand"
                MouseLeftButtonUp="Toast_Click">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <DockPanel Margin="12,10,18,12">
                    <Border Width="38" Height="38" CornerRadius="3" Background="{StaticResource Blue}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastIcon" Text="L" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitle" Text="LEGO ONLINE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}"/>
                        <TextBlock x:Name="ToastText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource Blue}"/>
            </Grid>
        </Border>

        <!-- Details zum gewaehlten Spiel -->
        <Grid x:Name="DetailsOverlay" Visibility="Collapsed">
            <Rectangle MouseLeftButtonUp="CloseOverlays_Click">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F2000000" Offset="0"/>
                        <GradientStop Color="#B3000000" Offset="0.5"/>
                        <GradientStop Color="#40000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="96,0,0,0" MaxWidth="760">
                <Image Source="{Binding SelectedGame.Logo}" MaxHeight="170" MaxWidth="560" HorizontalAlignment="Left" Stretch="Uniform"
                       Margin="0,0,0,22"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border CornerRadius="12" Padding="12,4" Margin="0,0,10,0" Background="#33FFFFFF">
                        <TextBlock Text="{Binding SelectedGame.StatusText}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="12" Padding="12,4" Margin="0,0,10,0" Background="#33FFFFFF">
                        <TextBlock Text="2 SPIELER · ONLINE" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="12" Padding="12,4" Background="#33FFFFFF">
                        <TextBlock Text="{Binding SelectedGame.Year}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding SelectedGame.Description}" TextWrapping="Wrap" FontSize="16" LineHeight="25"
                           Foreground="#E6E8EC" Margin="0,0,0,28"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PillButton}" Content="{Binding SelectedGame.PlayText}"
                            IsEnabled="{Binding SelectedGame.Available}" Click="Play_Click"/>
                    <Button Style="{StaticResource SoftButton}" Content="+ Neue Welt" Margin="12,0,0,0" Click="NewWorld_Click"
                            Visibility="{Binding IsBatman1, Converter={StaticResource BoolVis}}"/>
                    <Button Style="{StaticResource SoftButton}" Content="Freunde" Margin="12,0,0,0" Click="OpenFriends_Click"/>
                    <Button Style="{StaticResource SoftButton}" Content="Zurück" Margin="12,0,0,0" Click="CloseOverlays_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Seitenleiste: Freunde und Welten -->
        <Grid x:Name="DrawerLayer" Visibility="Collapsed">
            <Rectangle Fill="#80000000" MouseLeftButtonUp="CloseOverlays_Click"/>
            <Border x:Name="Drawer" Width="440" HorizontalAlignment="Right" Background="{StaticResource Sheet}" Padding="26,26,22,22">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DrawerShift"/>
                </Border.RenderTransform>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Style="{StaticResource TopIcon}" Margin="0" Click="CloseOverlays_Click" ToolTip="Schließen (Esc)">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE711;" FontSize="13"/>
                        </Button>
                        <TextBlock Text="Freunde" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Eigener Code -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource Row}" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Kopieren" Padding="12,5" FontSize="12"
                                    Click="Copy_Click" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="DEIN FREUNDESCODE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}"/>
                                <TextBlock Text="{Binding MyCode}" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Freund hinzufuegen -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Hinzufügen" Margin="8,0,0,0"
                                    Padding="14,6" FontSize="13" Click="AddFriend_Click"/>
                            <TextBox x:Name="FriendCodeBox" FontFamily="Consolas" CharacterCasing="Upper" MaxLength="20"
                                     KeyDown="FriendCodeBox_KeyDown" ToolTip="Code deines Freundes, z. B. ABCD-EFGH-JKLM"
                                     Background="#33000000" BorderBrush="#33FFFFFF"/>
                        </DockPanel>
                        <TextBlock x:Name="AddResult" Foreground="{StaticResource Soft}" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Welten (nur LEGO Batman 1) -->
                    <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding IsBatman1, Converter={StaticResource BoolVis}}" Margin="0,14,0,0">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="+ Neue Welt" Padding="12,5" FontSize="12"
                                    Click="NewWorld_Click"/>
                            <TextBlock Text="Gemeinsame Welten" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <CheckBox IsChecked="{Binding AutoLoad}" Margin="0,0,0,10" FontSize="12" Foreground="{StaticResource Soft}"
                                  Content="Spielstand beim Zusammenspielen automatisch laden"/>
                        <TextBlock Text="Noch keine Welt. Erstelle mit „+ Neue Welt“ eure erste."
                                   Foreground="{StaticResource Dim}" TextWrapping="Wrap" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Worlds.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Worlds}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Row}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="📁" Style="{StaticResource Quiet}" ToolTip="Sicherungen öffnen" Click="OpenBackups_Click"/>
                                                        <Button Content="✕" Style="{StaticResource Quiet}" ToolTip="Welt entfernen" Click="RemoveWorld_Click"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Ellipse DataContext="{Binding Partner}" Style="{StaticResource PresenceDot}" Margin="0,0,7,0"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="{Binding PartnerText, Mode=OneWay}"/>
                                                        <Run Text="·" Foreground="{StaticResource Dim}"/>
                                                        <Run Text="{Binding PartnerStatus, Mode=OneWay}" Foreground="{StaticResource Dim}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Dim}" FontSize="11"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding SyncText}" Foreground="{StaticResource Dim}" FontSize="11"
                                                           FontStyle="Italic" Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="Zusammen spielen" Style="{StaticResource PillButton}" Padding="14,6" FontSize="13"
                                                            Margin="0,0,8,0" Click="PlayTogether_Click" IsEnabled="{Binding CanPlayTogether}"/>
                                                    <Button Content="Alleine" Style="{StaticResource SoftButton}" Padding="14,6" FontSize="13"
                                                            Click="PlaySolo_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Freundesliste -->
                    <Grid>
                        <TextBlock Text="Noch keine Freunde. Gib oben den Code deines Freundes ein und schick ihm deinen."
                                   Foreground="{StaticResource Dim}" TextWrapping="Wrap" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Friends.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Friends}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Row}" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Annehmen" Style="{StaticResource PillButton}" Margin="0,0,4,0" Padding="12,5" FontSize="12"
                                                            Click="AcceptFriend_Click"
                                                            Visibility="{Binding IsIncoming, Converter={StaticResource BoolVis}}"/>
                                                    <Button Content="Einladen" Style="{StaticResource SoftButton}" Margin="0,0,4,0" Padding="12,5" FontSize="12"
                                                            ToolTip="Zusammen LEGO Batman 2 spielen"
                                                            Click="PlayBatman2_Click" IsEnabled="{Binding Online}">
                                                        <Button.Visibility>
                                                            <MultiBinding Converter="{StaticResource AllTrueVis}">
                                                                <Binding Path="IsFriend"/>
                                                                <Binding Path="DataContext.IsBatman2" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </Button.Visibility>
                                                    </Button>
                                                    <Button Content="✕" Style="{StaticResource Quiet}" ToolTip="Entfernen" Click="RemoveFriend_Click"/>
                                                </StackPanel>
                                                <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Ellipse Fill="#3B4250"/>
                                                    <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse Style="{StaticResource PresenceDot}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                             Stroke="#131519" StrokeThickness="2" Width="12" Height="12"/>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource Dim}">
                                                        <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                                        <Run Text="  ·  "/>
                                                        <Run Text="{Binding Code, Mode=OneWay}" FontFamily="Consolas"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Freund fuer LEGO Batman 2 waehlen -->
        <Border x:Name="PickFriendOverlay" Background="#CC000000" Visibility="Collapsed">
            <ContentControl Style="{StaticResource Panel}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="LEGO BATMAN 2"/>
                    <TextBlock Text="Wen möchtest du einladen?" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <ListBox x:Name="PickFriendList" Style="{StaticResource CardList}" MaxHeight="240" MouseDoubleClick="PickFriendOk_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource PresenceDot}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Dim}" Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="PickFriendError" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Abbrechen" Style="{StaticResource SoftButton}" Margin="0,0,10,0" Click="PickFriendCancel_Click"/>
                        <Button Content="Einladen" Style="{StaticResource PillButton}" Padding="24,9" FontSize="15" Click="PickFriendOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </Border>

        <!-- Neue Welt -->
        <Border x:Name="NewWorldOverlay" Background="#CC000000" Visibility="Collapsed">
            <ContentControl Style="{StaticResource Panel}" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="LEGO BATMAN"/>
                    <TextBlock Text="Neue Welt" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <TextBlock Style="{StaticResource Heading}" Text="NAME"/>
                    <TextBox x:Name="WorldNameBox" MaxLength="24" Margin="0,0,0,14"/>
                    <TextBlock Style="{StaticResource Heading}" Text="MIT WEM?"/>
                    <ListBox x:Name="PartnerList" Style="{StaticResource CardList}" MaxHeight="130" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource PresenceDot}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Heading}" Text="WOMIT STARTET IHR?" Margin="0,6,0,8"/>
                    <ListBox x:Name="SeedList" Style="{StaticResource CardList}" MaxHeight="170">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource Dim}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Dein eigener Spielstand bleibt unverändert – die Welt bekommt eine Kopie."
                               Foreground="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="NewWorldError" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Abbrechen" Style="{StaticResource SoftButton}" Margin="0,0,10,0" Click="CancelNewWorld_Click"/>
                        <Button Content="Welt erstellen" Style="{StaticResource PillButton}" Padding="24,9" FontSize="15" Click="CreateWorld_Click"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </Border>

        <!-- Einladung erhalten -->
        <Border Background="#CC000000" Visibility="{Binding HasIncoming, Converter={StaticResource BoolVis}}">
            <ContentControl Style="{StaticResource Panel}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="EINLADUNG"/>
                    <TextBlock Text="{Binding Incoming.Text}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Das Spiel startet nach dem Annehmen automatisch."
                               Foreground="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Ablehnen" Style="{StaticResource SoftButton}" Margin="0,0,10,0" Click="Decline_Click"/>
                        <Button Content="Annehmen und spielen" Style="{StaticResource PillButton}" Padding="24,9" FontSize="15" Click="AcceptInvite_Click"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </Border>

        <!-- Laufende Sitzung -->
        <Border Background="#CC000000" Visibility="{Binding SessionActive, Converter={StaticResource BoolVis}}">
            <ContentControl Style="{StaticResource Panel}" Width="470" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="SITZUNG"/>
                    <TextBlock Text="{Binding SessionText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,18,0,18" Foreground="{StaticResource Blue}"
                                 Background="#22FFFFFF" BorderThickness="0"/>
                    <TextBlock Text="Lass dieses Fenster offen, solange du spielst."
                               Foreground="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Button Content="Abbrechen" Style="{StaticResource SoftButton}" HorizontalAlignment="Right" Click="CancelSession_Click"/>
                </StackPanel>
            </ContentControl>
        </Border>

        <!-- Ersteinrichtung: Name -->
        <Border x:Name="SetupOverlay" Background="#E6000000" Visibility="Collapsed">
            <ContentControl Style="{StaticResource Panel}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="WILLKOMMEN"/>
                    <TextBlock Text="LEGO Online" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock Text="Spiele LEGO-Spiele mit einem Freund übers Internet. Wie sollen dich deine Freunde sehen?"
                               Foreground="{StaticResource Soft}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="13"/>
                    <TextBox x:Name="NameBox" MaxLength="24" KeyDown="NameBox_KeyDown"/>
                    <Button Content="Los geht's" Style="{StaticResource PillButton}" Padding="24,9" FontSize="15" HorizontalAlignment="Right"
                            Margin="0,18,0,0" Click="SaveName_Click"/>
                </StackPanel>
            </ContentControl>
        </Border>
    </Grid>
</Window>
